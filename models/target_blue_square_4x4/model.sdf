<?xml version="1.0"?>
<sdf version="1.9">
  <model name="target_blue_square_4x4">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- 4.0 m x 4.0 m mavi kare hedef, zemin üzerinde 5 cm kalınlık -->
    <link name="target">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>40.0</mass>
        <inertia>
          <ixx>53.35</ixx>
          <iyy>53.35</iyy>
          <izz>106.67</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="target_visual">
        <geometry>
          <box>
            <size>4.0 4.0 0.05</size>
          </box>
        </geometry>
        <material>
          <!-- TEKNOFEST mavi (yüksek albedo, kamera tanıma için doygun) -->
          <ambient>0.00 0.15 0.75 1</ambient>
          <diffuse>0.00 0.25 0.95 1</diffuse>
          <specular>0.20 0.20 0.30 1</specular>
          <emissive>0.00 0.02 0.08 1</emissive>
        </material>
      </visual>
      <collision name="target_collision">
        <geometry>
          <box>
            <size>4.0 4.0 0.05</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
