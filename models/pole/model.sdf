<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pole">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Direk gövdesi: 8 m yükseklik, 0.20 m çap (kaide üstünden başlar) -->
    <link name="shaft">
      <pose>0 0 4.30 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>266.7</ixx>
          <iyy>266.7</iyy>
          <izz>0.25</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="shaft_visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>8.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.40 0.05 1</ambient>
          <diffuse>1.00 0.45 0.05 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <collision name="shaft_collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>8.0</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Tepe işaretçisi (beyaz küre) -->
    <link name="marker">
      <pose>0 0 8.65 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.045</ixx>
          <iyy>0.045</iyy>
          <izz>0.045</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="marker_visual">
        <geometry>
          <sphere>
            <radius>0.35</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>1.00 1.00 1.00 1</diffuse>
          <specular>0.50 0.50 0.50 1</specular>
        </material>
      </visual>
      <collision name="marker_collision">
        <geometry>
          <sphere>
            <radius>0.35</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- Beton kaide -->
    <link name="base">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>80.0</mass>
        <inertia>
          <ixx>5.0</ixx>
          <iyy>5.0</iyy>
          <izz>8.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.80 0.80 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.80 0.80 0.30</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
