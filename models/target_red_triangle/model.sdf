<?xml version="1.0"?>
<sdf version="1.9">
  <model name="target_red_triangle">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!--
      Eşkenar üçgen: kenar uzunluğu = 1.0 m
      Yükseklik = sqrt(3)/2 ≈ 0.866 m
      Mesh: meshes/triangle.stl (5 cm kalınlık prizma, centroid orijinde)
    -->
    <link name="target">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.30</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="target_visual">
        <geometry>
          <mesh>
            <uri>model://target_red_triangle/meshes/triangle.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.70 0.02 0.02 1</ambient>
          <diffuse>0.95 0.05 0.05 1</diffuse>
          <specular>0.30 0.15 0.15 1</specular>
          <emissive>0.08 0.00 0.00 1</emissive>
        </material>
      </visual>
      <collision name="target_collision">
        <geometry>
          <mesh>
            <uri>model://target_red_triangle/meshes/triangle.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
