<?xml version="1.0"?>
<model>
  <name>teknofest_fixed_wing</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>IHAILOS Team</name>
    <email>sim@teknofest.local</email>
  </author>
  <description>
    TEKNOFEST 2026 Sabit Kanat İHA Şartnamesine (V6) tam uyumlu geleneksel sabit kanat modeli.
    MTOW: 3.40 kg (4.0 kg altı limit), silindirik muhafaza uyumlu 1.60 m kanat açıklığı,
    üç nokta iniş takımı, eleron + irtifa + yön dümeni + flap kontrol yüzeyleri,
    2 adet pasif faydalı yük (Kırmızı + Mavi), gövde altı 30 derece öne açılı tek RGB kamera
    (1280x720 @ 30 FPS) ve 1D AGL LiDAR mesafe sensörü içerir.
  </description>
</model>
