<?xml version="1.0"?>
<!--
  TEKNOFEST 2026 Sabit Kanat İHA — Şartname V6 Uyumlu Simülasyon Modeli
  ======================================================================
  Şartname Uyumluluk Özeti:
  - Hava Aracı Tipi : Geleneksel yüksek kanatlı sabit kanat (VTOL/DİKY değildir)
  - Kanat Açıklığı  : 1.60 m (silindirik muhafaza kutusuna sığacak 2 parçalı kanat)
  - Gövde Uzunluğu  : 1.15 m
  - Yüksüz Ağırlık  : W0 = 2.20 kg
  - Faydalı Yükler  : 2 adet (Kırmızı Yük = 0.60 kg + Mavi Yük = 0.60 kg)
  - Toplam Ağırlık  : MTOW = 3.40 kg (Şartname üst limiti <= 4.00 kg)
  - Kontrol Yüzeyleri:
      * Kanal 0 (SERVO1): Sol & Sağ Eleron (Aileron)
      * Kanal 1 (SERVO2): İrtifa Dümeni (Elevator)
      * Kanal 2 (SERVO3): Burun Çekici Motor & Pervane (Throttle)
      * Kanal 3 (SERVO4): Yön Dümeni (Rudder)
      * Kanal 4 (SERVO5): Sol & Sağ Flaplar (Flaps — Şartname Madde 3.4 fail-safe uyumlu)
  - Sensörler:
      * Tek Görev Kamerası (Madde 4.2): Gövde altında 30° öne açılı (pitch = 0.523599 rad),
        1280x720 @ 30 FPS, HFOV = 1.014197 rad (IHAILOS fx=1152.0 ile tam eşleşir),
        Topic: /camera/image_raw
      * AGL Mesafe Sensörü (Madde 3.5 & 10): Gövde altında aşağı yönlü 1D LiDAR (0.20 - 120 m),
        Topic: /rangefinder
      * IMU (1000 Hz) & NavSat (GPS)
-->
<sdf version="1.9">
  <model name="teknofest_fixed_wing">
    <pose>0 0 0.22 0 0 0</pose>

    <!-- ===================================================================
         ANA GÖVDE + SABİT KANAT + KUYRUK + İNİŞ TAKIMI + 2 YÜK + SENSÖRLER
         Toplam kütle: 2.20 kg (yüksüz) + 1.20 kg (2x0.60 kg yük) = 3.40 kg
         =================================================================== -->
    <link name="base_link">
      <inertial>
        <pose>0.02 0 0.0 0 0 0</pose>
        <mass>3.25</mass>
        <inertia>
          <ixx>0.185</ixx>
          <ixy>0.0</ixy>
          <ixz>0.012</ixz>
          <iyy>0.240</iyy>
          <iyz>0.0</iyz>
          <izz>0.380</izz>
        </inertia>
      </inertial>

      <!-- Gövde (Fuselage) -->
      <visual name="fuselage_visual">
        <pose>0.05 0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 0.12 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.92 0.95 1</ambient>
          <diffuse>0.95 0.96 0.98 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>

      <!-- Burun Koniği (Nose Cone) -->
      <visual name="nose_visual">
        <pose>0.42 0 0.0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.048</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.22 0.22 0.25 1</diffuse>
        </material>
      </visual>

      <!-- Karbon Kuyruk Borusu (Tail Boom) -->
      <visual name="tail_boom_visual">
        <pose>-0.45 0 0.02 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.016</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Ana Yüksek Kanat (High Wing - 1.60 m açıklık, 0.22 m veter) -->
      <visual name="main_wing_visual">
        <pose>0.02 0 0.075 0 0.05 0</pose>
        <geometry>
          <box>
            <size>0.22 1.60 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.15 0.10 1</ambient>
          <diffuse>0.95 0.20 0.12 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- Yatay Stabilizör (Horizontal Stabilizer) -->
      <visual name="hstab_visual">
        <pose>-0.68 0 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.48 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.15 0.10 1</ambient>
          <diffuse>0.95 0.20 0.12 1</diffuse>
        </material>
      </visual>

      <!-- Dikey Stabilizör (Vertical Stabilizer) -->
      <visual name="vstab_visual">
        <pose>-0.68 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.012 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.15 0.10 1</ambient>
          <diffuse>0.95 0.20 0.12 1</diffuse>
        </material>
      </visual>

      <!-- =================================================================
           ŞARTNAME GÖREV 2: 2 ADET FAYDALI YÜK (KIRMIZI YÜK & MAVİ YÜK)
           Madde 2.1 & 4:
             - Yük 1 (Kırmızı): 4x4 m Mavi Kare hedefe bırakılacak (AUX 9)
             - Yük 2 (Mavi)   : 2x2 m Kırmızı Kare hedefe bırakılacak (AUX 10)
           ================================================================= -->
      <visual name="payload_1_red_visual">
        <pose>0.02 0.045 -0.075 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.80 0.02 0.02 1</ambient>
          <diffuse>0.95 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <visual name="payload_2_blue_visual">
        <pose>0.02 -0.045 -0.075 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.00 0.18 0.80 1</ambient>
          <diffuse>0.00 0.28 0.95 1</diffuse>
        </material>
      </visual>

      <!-- =================================================================
           ÜÇ NOKTA İNİŞ TAKIMI (Tricycle Landing Gear - Pist Kalkış/İniş)
           ================================================================= -->
      <visual name="nose_gear_strut_visual">
        <pose>0.30 0 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
        </material>
      </visual>
      <visual name="nose_wheel_visual">
        <pose>0.30 0 -0.175 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="main_gear_left_wheel_visual">
        <pose>-0.04 0.16 -0.175 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="main_gear_right_wheel_visual">
        <pose>-0.04 -0.16 -0.175 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Gövde & İniş Takımı Çarpışma Geometrileri (Düşük sürtünmeli kızak/tekerlek) -->
      <collision name="fuselage_collision">
        <pose>0.0 0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.90 0.14 0.14</size>
          </box>
        </geometry>
      </collision>
      <collision name="wing_collision">
        <pose>0.02 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 1.60 0.025</size>
          </box>
        </geometry>
      </collision>
      <collision name="nose_wheel_collision">
        <pose>0.30 0 -0.175 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.02</mu>
              <mu2>0.40</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="left_wheel_collision">
        <pose>-0.04 0.16 -0.175 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.040</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.02</mu>
              <mu2>0.50</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="right_wheel_collision">
        <pose>-0.04 -0.16 -0.175 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.040</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.02</mu>
              <mu2>0.50</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="tail_skid_collision">
        <pose>-0.70 0 -0.08 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.30</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- =================================================================
           SENSÖR 1: IMU (ArduPilotPlugin için 1000 Hz)
           ================================================================= -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 3.141593 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <!-- =================================================================
           SENSÖR 2: NavSat (GPS)
           ================================================================= -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>10.0</update_rate>
      </sensor>

      <!-- =================================================================
           SENSÖR 3: TEK GÖREV KAMERASI (Şartname Madde 4.2 & Blueprint B4)
           - Gövde altında buruna yakın (0.22, 0, -0.07)
           - Uçuş yönüne doğru 30° öne açılı (pitch = 30° = 0.523599 rad)
           - 1280x720 @ 30 FPS, HFOV = 1.014197 rad (IHAILOS fx=1152.0 uyumlu)
           - Topic: camera/image_raw
           ================================================================= -->
      <visual name="camera_housing_visual">
        <pose>0.22 0 -0.065 0 0.523599 0</pose>
        <geometry>
          <box>
            <size>0.045 0.040 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>

      <sensor name="down_camera" type="camera">
        <pose>0.22 0 -0.075 0 0.523599 0</pose>
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>
        <topic>camera/image_raw</topic>
        <camera name="ihailos_oblique_cam">
          <horizontal_fov>1.014197</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>1500.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- =================================================================
           SENSÖR 4: 1D AGL LiDAR / RANGEFINDER (Şartname Madde 3.5 & 10)
           - Gövde altında tam aşağı bakan (pitch = 90° = 1.570796 rad)
           - Menzil: 0.20 m - 120.0 m (SHGM 120 m AGL üst sınırını kapsar)
           - Topic: rangefinder
           ================================================================= -->
      <sensor name="agl_lidar" type="gpu_lidar">
        <pose>0.10 0 -0.075 0 1.570796 0</pose>
        <always_on>1</always_on>
        <update_rate>20.0</update_rate>
        <visualize>true</visualize>
        <topic>rangefinder</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>120.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ===================================================================
         BURUN PERVANESİ (Propeller - Kanal 2 / SERVO3 Throttle)
         =================================================================== -->
    <link name="propeller">
      <pose>0.48 0 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00015</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00008</iyy>
          <iyz>0</iyz>
          <izz>0.00008</izz>
        </inertia>
      </inertial>
      <visual name="blade_1">
        <pose>0 0.07 0 0.35 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.14 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <visual name="blade_2">
        <pose>0 -0.07 0 -0.35 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.14 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>propeller</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.001</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================================
         SOL & SAĞ ELERON (Ailerons - Kanal 0 / SERVO1)
         =================================================================== -->
    <link name="left_aileron">
      <pose>-0.08 0.56 0.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.045 0.36 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.10 1</ambient>
          <diffuse>1.00 0.85 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_aileron</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="right_aileron">
      <pose>-0.08 -0.56 0.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.045 0.36 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.10 1</ambient>
          <diffuse>1.00 0.85 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_aileron</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================================
         SOL & SAĞ FLAPLAR (Flaps - Kanal 4 / SERVO5 — Şartname Madde 3.4)
         =================================================================== -->
    <link name="left_flap">
      <pose>-0.08 0.22 0.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.045 0.26 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.65 0.25 1</ambient>
          <diffuse>0.25 0.80 0.30 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_flap_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_flap</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.10</lower>
          <upper>0.70</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="right_flap">
      <pose>-0.08 -0.22 0.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.045 0.26 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.65 0.25 1</ambient>
          <diffuse>0.25 0.80 0.30 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_flap_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_flap</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.10</lower>
          <upper>0.70</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================================
         İRTİFA DÜMENİ (Elevator - Kanal 1 / SERVO2)
         =================================================================== -->
    <link name="elevator">
      <pose>-0.76 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.045 0.46 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.10 1</ambient>
          <diffuse>1.00 0.85 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="elevator_joint" type="revolute">
      <parent>base_link</parent>
      <child>elevator</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================================
         YÖN DÜMENİ (Rudder - Kanal 3 / SERVO4)
         =================================================================== -->
    <link name="rudder">
      <pose>-0.76 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.050 0.010 0.17</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.10 1</ambient>
          <diffuse>1.00 0.85 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rudder_joint" type="revolute">
      <parent>base_link</parent>
      <child>rudder</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================================
         EKLEM KUVVET SİSTEMLERİ (ApplyJointForce)
         =================================================================== -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>propeller_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_aileron_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_aileron_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_flap_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_flap_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>elevator_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rudder_joint</joint_name>
    </plugin>

    <!-- ===================================================================
         AERODİNAMİK YÜZEYLER (LiftDrag Plugins)
         =================================================================== -->
    <!-- Sol Kanat + Sol Eleron -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.08</a0>
      <cla>4.75</cla>
      <cda>0.06</cda>
      <cma>-0.20</cma>
      <alpha_stall>0.35</alpha_stall>
      <cla_stall>-3.5</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.0 0.40 0.075</cp>
      <area>0.18</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.8</control_joint_rad_to_cl>
    </plugin>

    <!-- Sağ Kanat + Sağ Eleron -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.08</a0>
      <cla>4.75</cla>
      <cda>0.06</cda>
      <cma>-0.20</cma>
      <alpha_stall>0.35</alpha_stall>
      <cla_stall>-3.5</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.0 -0.40 0.075</cp>
      <area>0.18</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.8</control_joint_rad_to_cl>
    </plugin>

    <!-- Sol Flap Katkısı -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.02</a0>
      <cla>2.5</cla>
      <cda>0.08</cda>
      <cma>-0.10</cma>
      <alpha_stall>0.40</alpha_stall>
      <cla_stall>-2.0</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.02 0.22 0.075</cp>
      <area>0.06</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_flap_joint</control_joint_name>
      <control_joint_rad_to_cl>1.5</control_joint_rad_to_cl>
    </plugin>

    <!-- Sağ Flap Katkısı -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.02</a0>
      <cla>2.5</cla>
      <cda>0.08</cda>
      <cma>-0.10</cma>
      <alpha_stall>0.40</alpha_stall>
      <cla_stall>-2.0</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.02 -0.22 0.075</cp>
      <area>0.06</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_flap_joint</control_joint_name>
      <control_joint_rad_to_cl>1.5</control_joint_rad_to_cl>
    </plugin>

    <!-- Yatay Stabilizör + İrtifa Dümeni (Elevator) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.02</a0>
      <cla>4.2</cla>
      <cda>0.05</cda>
      <cma>-0.15</cma>
      <alpha_stall>0.35</alpha_stall>
      <cla_stall>-3.2</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.70 0 0.03</cp>
      <area>0.07</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>elevator_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.5</control_joint_rad_to_cl>
    </plugin>

    <!-- Dikey Stabilizör + Yön Dümeni (Rudder) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>4.0</cla>
      <cda>0.05</cda>
      <cma>-0.10</cma>
      <alpha_stall>0.35</alpha_stall>
      <cla_stall>-3.0</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.70 0 0.12</cp>
      <area>0.035</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>base_link</link_name>
      <control_joint_name>rudder_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.5</control_joint_rad_to_cl>
    </plugin>

    <!-- Pervane Pala 1 (İtki) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.30</a0>
      <cla>5.0</cla>
      <cda>0.15</cda>
      <cma>0.0</cma>
      <alpha_stall>1.4</alpha_stall>
      <cla_stall>-3.0</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.0 0.08 0.0</cp>
      <area>0.008</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>1 0 0</upward>
      <link_name>propeller</link_name>
    </plugin>

    <!-- Pervane Pala 2 (İtki) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.30</a0>
      <cla>5.0</cla>
      <cda>0.15</cda>
      <cma>0.0</cma>
      <alpha_stall>1.4</alpha_stall>
      <cla_stall>-3.0</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.0 -0.08 0.0</cp>
      <area>0.008</area>
      <air_density>1.2041</air_density>
      <forward>0 1 0</forward>
      <upward>1 0 0</upward>
      <link_name>propeller</link_name>
    </plugin>

    <!-- ===================================================================
         ARDUPILOT GAZEBO EKLENTİSİ (JSON SITL Köprüsü - Port 9002)
         =================================================================== -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.570796</gazeboXYZToNED>
      <imuName>base_link::imu_sensor</imuName>

      <!-- Kanal 0 (SERVO1): Sol Eleron -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.2</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- Kanal 0 (SERVO1): Sağ Eleron (ters yön) -->
      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-1.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.2</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- Kanal 1 (SERVO2): İrtifa Dümeni (Elevator) -->
      <control channel="1">
        <jointName>elevator_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.2</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- Kanal 2 (SERVO3): Gaz / Motor (Throttle) -->
      <control channel="2">
        <jointName>propeller_joint</jointName>
        <useForce>1</useForce>
        <multiplier>950</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.25</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>0.0</cmd_min>
      </control>

      <!-- Kanal 3 (SERVO4): Yön Dümeni (Rudder) -->
      <control channel="3">
        <jointName>rudder_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.2</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- Kanal 4 (SERVO5): Sol Flap -->
      <control channel="4">
        <jointName>left_flap_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.65</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>8.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.1</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </control>

      <!-- Kanal 4 (SERVO5): Sağ Flap -->
      <control channel="4">
        <jointName>right_flap_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.65</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>8.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.1</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>

